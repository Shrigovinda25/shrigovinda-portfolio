# ─────────────────────────────────────────────────────────────────────────────
# Upload Service — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3004

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id",...}
# OR: GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIREBASE_PROJECT_ID=shrigovinda-portfolio
FIREBASE_STORAGE_BUCKET=shrigovinda-portfolio.firebasestorage.app

# ── Upload Limits ─────────────────────────────────────────────────────────────
# Max file size in bytes (default 10 MB = 10485760)
MAX_FILE_SIZE=10485760

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://shrigovinda.netlify.app
