# ─────────────────────────────────────────────────────────────────────────────
# Auth Service — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3001

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"..."}
# OR: GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIREBASE_PROJECT_ID=shrigovinda-portfolio

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://shrigovinda.netlify.app
