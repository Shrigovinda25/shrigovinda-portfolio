# ─────────────────────────────────────────────────────────────────────────────
# Contact Service — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3002

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A: Paste the entire serviceAccountKey.json content as a JSON string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Option B: Path to your serviceAccountKey.json file (relative to service root)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

FIREBASE_PROJECT_ID=shrigovinda-portfolio
FIREBASE_STORAGE_BUCKET=shrigovinda-portfolio.firebasestorage.app

# ── Email (Nodemailer via Gmail) ──────────────────────────────────────────────
# Generate a Gmail App Password: myaccount.google.com → Security → 2-Step → App Passwords
# Set to "false" to disable email notifications (form still saves to Firestore)
ENABLE_EMAIL_NOTIFICATIONS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-16-char-app-password
CONTACT_RECIPIENT_EMAIL=shrigovindak@gmail.com

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no trailing slashes)
ALLOWED_ORIGINS=http://localhost:3000,https://shrigovinda.netlify.app
