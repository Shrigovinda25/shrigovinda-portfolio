# ─────────────────────────────────────────────────────────────────────────────
# API Gateway — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080

# ── Service URLs ──────────────────────────────────────────────────────────────
# Local development (all services running on localhost)
AUTH_SERVICE_URL=http://localhost:3001
CONTACT_SERVICE_URL=http://localhost:3002
PORTFOLIO_SERVICE_URL=http://localhost:3003
UPLOAD_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:3005

# Production (replace with your deployed service URLs)
# AUTH_SERVICE_URL=https://shrigovinda-auth.vercel.app
# CONTACT_SERVICE_URL=https://shrigovinda-contact.vercel.app
# PORTFOLIO_SERVICE_URL=https://shrigovinda-portfolio-api.vercel.app
# UPLOAD_SERVICE_URL=https://shrigovinda-upload.vercel.app
# AI_SERVICE_URL=https://shrigovinda-ai.vercel.app

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://shrigovinda.netlify.app
